#!/bin/bash
#
# vnc-single-display - give screen-sharing clients a single display
# Copyright (C) 2026 Lucio Oliveira
#
# This program is free software: you can redistribute it and/or modify it
# under the terms of the GNU General Public License as published by the Free
# Software Foundation, either version 3 of the License, or (at your option)
# any later version.
#
# This program is distributed in the hope that it will be useful, but WITHOUT
# ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS
# FOR A PARTICULAR PURPOSE. See the GNU General Public License for more details.
#
# You should have received a copy of the GNU General Public License along with
# this program. If not, see <https://www.gnu.org/licenses/>.
#
# Collapses the display layout to a single origin while a screen-sharing viewer
# is connected, and restores the multi-display layout once it leaves.
#
# Restoring is the hard requirement. The ownership flag, the startup reconcile
# and the exit trap all exist so the original layout comes back even if this
# process is killed, crashes, or the machine reboots mid-session. A layout the
# user mirrored themselves is never touched.

set -u

BIN="${VNCSD_BIN:-$HOME/.local/bin/vncdisplay}"
STATE_DIR="${VNCSD_STATE_DIR:-$HOME/.local/state/vnc-single-display}"
OWN_FLAG="$STATE_DIR/owned-by-watcher"
SEEN_FILE="$STATE_DIR/last-seen"
START_FILE="$STATE_DIR/streak-start"
LOCK_DIR="$STATE_DIR/lock"
LOG="${VNCSD_LOG:-$HOME/Library/Logs/vnc-single-display.log}"
PORT="${VNCSD_PORT:-5900}"
STABLE="${VNCSD_STABLE:-8}"  # a session at least this long counts as deliberate
GRACE="${VNCSD_GRACE:-5}"    # how long to hold the mirror after a short session

mkdir -p "$STATE_DIR" "$(dirname "$LOG")"

log() { printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG"; }
now() { date +%s; }

# Counted from netstat rather than lsof: the screen-sharing daemon runs as root,
# and an unprivileged lsof cannot list another user's sockets, so it reports no
# viewers even while a session is live. netstat needs no privilege. Matching on
# the local address keeps a loopback connection from being counted twice.
# The dot before the port must be matched literally. Unescaped it is a regex
# wildcard, and the local address of any outgoing connection that happens to be
# assigned an ephemeral port ending in the same digits - 55900 or 65900 for the
# default 5900, both inside the 49152-65535 range macOS allocates from - would
# be counted as a viewer and collapse the layout with nobody connected.
viewers() {
    /usr/sbin/netstat -an -p tcp 2>/dev/null \
        | awk -v port="$PORT" '$4 ~ "\\."port"$" && $6 == "ESTABLISHED" { n++ } END { print n + 0 }'
}

read_epoch() {
    local v
    v=$(cat "$1" 2>/dev/null) || v=0
    case "$v" in ''|*[!0-9]*) v=0 ;; esac
    echo "$v"
}

# Records a viewer sighting, and tracks how long the current unbroken run of
# sightings has lasted. Sightings more than a couple of seconds apart belong to
# different connections, which is what separates one real session from the
# rapid connect-fail-retry loop a client falls into when a handshake breaks.
mark_seen() {
    local t prev
    t=$(now)
    prev=$(read_epoch "$SEEN_FILE")
    if [ $(( t - prev )) -gt 2 ]; then echo "$t" >"$START_FILE"; fi
    echo "$t" >"$SEEN_FILE"
}

streak_length() { echo $(( $(read_epoch "$SEEN_FILE") - $(read_epoch "$START_FILE") )); }
idle_seconds()  { echo $(( $(now) - $(read_epoch "$SEEN_FILE") )); }

# Every path that reconfigures displays runs through here. The log reader and
# the poll loop are separate processes and can reach it at the same moment.
with_lock() {
    mkdir "$LOCK_DIR" 2>/dev/null || return 0
    "$@"
    rmdir "$LOCK_DIR" 2>/dev/null
}

do_mirror_on() {
    mark_seen
    # A flag that outlived the mirror it described would suppress every later
    # session, since the watcher skips mirroring whatever it already owns.
    if [ -e "$OWN_FLAG" ]; then
        "$BIN" is-mirrored && return 0
        rm -f "$OWN_FLAG"
        log "ownership flag cleared - the layout was no longer mirrored"
    fi
    if "$BIN" is-mirrored; then
        log "already mirrored outside this watcher - leaving it alone"
        return 0
    fi
    if "$BIN" mirror; then
        : >"$OWN_FLAG"
        log "MIRROR ON"
    else
        log "MIRROR ON FAILED"
    fi
}
mirror_on() { with_lock do_mirror_on; }

do_mirror_off() {
    [ -e "$OWN_FLAG" ] || return 0
    if "$BIN" unmirror; then
        rm -f "$OWN_FLAG" "$SEEN_FILE" "$START_FILE"
        log "MIRROR OFF - original layout restored after ${1:-?}"
    elif ! "$BIN" is-mirrored; then
        # The layout is already extended, so something else restored it. The
        # flag has to go even though the restore failed, or every following
        # tick retries a restore that has nothing left to undo.
        rm -f "$OWN_FLAG" "$SEEN_FILE" "$START_FILE"
        log "ownership flag cleared - the layout was already restored"
    else
        log "MIRROR OFF FAILED - still mirrored"
    fi
}
mirror_off() { with_lock do_mirror_off "$@"; }

# A session long enough to have been used is assumed to have ended because
# somebody closed it, so the layout comes back at once. A session that barely
# started is a failed handshake, and the client is about to try again: holding
# the mirror through that gap is the whole reason the grace period exists.
restore_if_due() {
    [ -e "$OWN_FLAG" ] || return 0
    [ "$(viewers)" -gt 0 ] && return 0
    local streak
    streak=$(streak_length)
    if [ "$streak" -ge "$STABLE" ]; then
        mirror_off "a ${streak}s session"
    elif [ "$(idle_seconds)" -ge "$GRACE" ]; then
        mirror_off "${GRACE}s idle following a ${streak}s session"
    fi
}

cleanup() {
    [ -n "${STREAM_PID:-}" ] && kill "$STREAM_PID" 2>/dev/null
    rmdir "$LOCK_DIR" 2>/dev/null
    do_mirror_off "watcher shutdown"
}
trap 'cleanup; exit 0' TERM INT HUP
trap cleanup EXIT

# A flag left behind by a killed watcher or a reboot means the layout is still
# collapsed with nobody watching it. Undo that before doing anything else.
if [ -e "$OWN_FLAG" ] && [ "$(viewers)" -eq 0 ] && [ "$(idle_seconds)" -ge "$GRACE" ]; then
    log "startup reconcile: stale mirror with no viewer"
    mirror_off "a stale mirror"
fi

log "watcher started (port $PORT, stable ${STABLE}s, grace ${GRACE}s)"

# The daemon announces both ends of a session, so neither has to wait for the
# next poll. On connect that matters because the window between the socket being
# accepted and the first frame being read is about a second; on disconnect it is
# what makes the layout come back immediately instead of up to a second later.
/usr/bin/log stream --level debug --style compact \
    --predicate 'process == "screensharingd" AND (eventMessage CONTAINS "accept new screen sharing connection" OR eventMessage CONTAINS "closing index")' \
    2>/dev/null | while IFS= read -r line; do
        # log stream opens with a banner that quotes the predicate back, so the
        # trigger text appears before any real event. Event lines always start
        # with a timestamp; anything else is header noise.
        case "$line" in
            [0-9]*"accept new screen sharing connection"*) mirror_on ;;
            [0-9]*"closing index"*) sleep 0.4; restore_if_due ;;
        esac
    done &
STREAM_PID=$!

# Slow path: reconciles against real socket state, and backs up both decisions.
while :; do
    if [ "$(viewers)" -gt 0 ]; then
        mirror_on
    else
        restore_if_due
    fi
    sleep 1
done
